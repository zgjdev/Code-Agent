# CodeAgent 配置示例
# 用法：
# 1. 复制本文件为 .env
# 2. 按需填写下面的配置项
# 3. 未填写的项会回退到代码默认值

# ========== GLM 配置 ==========
# API Key（必填其一：GLM_API_KEY、DEEPSEEK_API_KEY、STEP_API_KEY、KIMI_API_KEY、FREELLMAPI_API_KEY、XFYUN_MAAS_API_KEY 或 AGNES_API_KEY）
GLM_API_KEY=your_api_key_here
# 模型名称（可选，默认 glm-5.1）
# 可选值：glm-5.1, glm-5v-turbo, glm-5.0, glm-4-flash 等
# glm-5v-turbo 支持图片输入，可配合 Ctrl+V / @image: 使用
# GLM_MODEL=glm-5.1
# ========== DeepSeek 配置 ==========
# API Key（/model deepseek 切换后使用）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 模型名称（可选，默认 deepseek-v4-flash）
# 可选值：deepseek-v4-flash, deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# ========== 阶跃星辰 StepFun 配置 ==========
# API Key（/model step 切换后使用）
# STEP_API_KEY=your_step_api_key_here
# 模型名称（可选，默认 step-3.5-flash）
# 可选值：step-3.5-flash, step-3.5-flash-2603, step-router-v1, step-1-256k 等
# STEP_MODEL=step-3.5-flash
# Base URL（可选，默认 https://api.stepfun.com/v1）
# 如果使用 Step Plan 专用通道，可设置为 https://api.stepfun.com/step_plan/v1
# STEP_BASE_URL=https://api.stepfun.com/v1

# ========== Kimi / Moonshot 配置 ==========
# API Key（/model kimi 切换后使用；兼容官方 MOONSHOT_API_KEY）
# KIMI_API_KEY=your_kimi_api_key_here
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# 模型名称（可选，默认 kimi-k2.6；兼容 MOONSHOT_MODEL）
# KIMI_MODEL=kimi-k2.6
# Base URL（可选，默认 https://api.moonshot.ai/v1；兼容 MOONSHOT_BASE_URL）
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# ========== FreeLLMAPI 本地网关配置 ==========
# API Key（/model freellmapi 切换后使用；可从 FreeLLMAPI /keys 顶部 unified API key 复制）
# FREELLMAPI_API_KEY=your_freellmapi_unified_key_here
# 模型名称（可选，默认 auto；也可填 /v1/models 返回的具体 model id）
# FREELLMAPI_MODEL=auto
# Base URL（可选，默认 http://localhost:5173/v1）
# FREELLMAPI_BASE_URL=http://localhost:5173/v1

# ========== Agnes AI 配置 ==========
# API Key（/model agnes 切换后使用；从 Agnes AI Platform 创建）
# AGNES_API_KEY=your_agnes_api_key_here
# 模型名称（可选，默认 agnes-2.0-flash）
# AGNES_MODEL=agnes-2.0-flash
# Base URL（可选，默认 https://apihub.agnes-ai.com/v1）
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# 代码 RAG 默认、长期记忆固定使用进程内 Qwen3-Embedding-0.6B FP32（1024 维）。
# 先执行 scripts/install-qwen3-model.ps1 安装固定版本模型；运行时不自动下载。
# 默认目录 ~/.codeagent/models/qwen3-embedding-0.6b/<固定 revision>。
EMBEDDING_MODE=local
# 自定义目录（绝对路径或相对项目路径；目录必须含校验匹配的三个模型文件）。
# EMBEDDING_LOCAL_MODEL_DIR=D:/models/qwen3-embedding-0.6b
# 长期记忆复用此本地模型目录；修改目录或修复安装后重启，不跟随 RAG mode/provider。
# 代码 RAG 本地 BGE 回滚：保持 mode=local 并设置 EMBEDDING_PROVIDER=bge。
# 显式切换远程时可选 glm / jina / openai-compatible，并会要求项目级授权。
# EMBEDDING_PROVIDER=glm
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=your_api_key_here

# ========== Web 搜索与抓取（MCP） ==========
# 所有模型默认 AnySearch search/extract，连接失败、超时、5xx或未就绪时降级 Step。
# 认证、额度、业务错误、策略/HITL拒绝与取消不降级；没有 direct HTTP 路由。
# ANYSEARCH_API_KEY 可选，无密钥匿名访问，认证失败不退回匿名。
# ANYSEARCH_API_KEY=your_anysearch_api_key_here
# 降级使用上方 STEP_API_KEY 接入普通 API MCP；缺少配置不会自动启用。
# 显式 mcp.json 同名 anysearch/step_search 配置（含 disabled）优先。
# 不再使用 SEARCH_PROVIDER、ZHIPU_SEARCH_ENGINE、SERPAPI_KEY、SEARXNG_URL。
# web_fetch 的 max_chars 在本地截断正文；请求URL校验私网，但远端重定向由MCP服务处理。

# ========== MCP 配置 ==========
# MCP server 配置文件位置：
# 1. 用户级 ~/.codeagent/mcp.json
# 2. 项目级 .codeagent/mcp.json（按 server 名覆盖用户级）
# 支持 ${PROJECT_DIR}、${HOME} 和环境变量 ${VAR} 展开。
# 远程 Streamable HTTP server 常用 token 示例：
# REMOTE_TOKEN=your_remote_mcp_token_here

# ========== 渲染器形态（v16.1+）==========
# 默认 inline 流式 TUI（Claude Code 风格：底部状态栏 + 行内可折叠工具块 + 行内 diff）
# CODEAGENT_RENDERER=inline    # 默认值，显式声明
# CODEAGENT_RENDERER=lanterna  # 切换到 Lanterna 三栏全屏 TUI（v16 形态，可选保留）
# CODEAGENT_RENDERER=plain     # 纯 println 兜底，无折叠/状态栏
# CODEAGENT_NO_STATUSBAR=true  # inline 模式下禁用底部状态栏（终端不支持 DECSTBM 时使用）

# 兼容旧设置：CODEAGENT_TUI=true 自动映射为 CODEAGENT_RENDERER=lanterna（已 deprecated）
# CODEAGENT_TUI=true

# ========== LSP 诊断注入（第 17 期）==========
# write_file 成功后触发 post-edit 诊断；当前 MVP 对 Java 文件使用 JavaParser 语法诊断，
# 不依赖本机安装 JDT LS。后续接真实 LSP server 时复用同一注入链路。
# CODEAGENT_LSP_ENABLED=true
# CODEAGENT_LSP_MAX_DIAGNOSTICS=20

# ========== Session Memory 自动压缩（实验功能）==========
# 默认 false：conversationHistory 到阈值时直接做完整摘要。
# 开启后会在阈值前异步维护当前 Agent 专属的增量会话摘要；达到阈值时优先使用该摘要，
# 摘要不可用、状态失效或压缩后仍超阈值时自动回退完整摘要。
# CODEAGENT_SESSION_MEMORY_COMPACTION_ENABLED=false

# Durable session recovery: auto resumes latest unfinished workspace session; off starts new.
# CODEAGENT_SESSION_RESUME=auto

# ========== Side-Git 快照与回滚（第 18 期）==========
# 每个用户 turn 开始前创建 pre-turn 快照，结束后异步创建 post-turn 快照。
# 快照仓库位于 ~/.codeagent/snapshots/<project_hash>/<worktree_hash>/.git，不写用户项目 .git。
# CODEAGENT_SNAPSHOT_ENABLED=true
# CODEAGENT_SNAPSHOT_MAX=50
# CODEAGENT_SNAPSHOT_EXCLUDES=.git,.codeagent/snapshots,target,node_modules,dist,.idea,*.class,*.jar
# CODEAGENT_SNAPSHOT_DIR=/Users/yourname/.codeagent/snapshots

# ========== 统一执行队列 + Runtime API ==========
# inline/plain 普通输入与 /task add 共用 SQLite 队列，默认位于 ~/.codeagent/tasks/tasks.db
# CODEAGENT_TASK_DIR=/Users/yourname/.codeagent/tasks
# 仅供旧 DurableTaskManager 使用；当前 CLI 统一队列固定单 Worker，不读取此设置。
# CODEAGENT_TASK_WORKERS=2

# Runtime API 仅监听 127.0.0.1，并强制要求 API Key。
# 启动示例：
#   CODEAGENT_RUNTIME_API_KEY=your_local_api_key java -jar target/codeagent-1.0-SNAPSHOT.jar serve --http --port 8080
# 请求头：
#   Authorization: Bearer your_local_api_key
# 或：
#   X-CodeAgent-API-Key: your_local_api_key
# CODEAGENT_RUNTIME_API_KEY=your_local_api_key
# CODEAGENT_RUNTIME_DIR=/Users/yourname/.codeagent/runtime

# ========== Chrome DevTools MCP ==========
# ~/.codeagent/mcp.json 不存在时，CodeAgent 会自动创建默认 chrome-devtools 配置：
# npx -y chrome-devtools-mcp@latest --isolated=true
# isolated 模式使用临时 user-data-dir；复用登录态时，Chrome 144+ 推荐在
# chrome://inspect/#remote-debugging 勾选 Allow remote debugging for this browser instance，
# 然后让 Agent 自动调用 browser_connect，或手动执行 /browser connect。
# 如果希望默认连接调试 Chrome，可手动把 ~/.codeagent/mcp.json args 改成：
# ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
# 旧式 CDP HTTP JSON 端口可改成：
# ["-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"]
# 如果首次启动 npx 拉包或 Chrome 冷启较慢，可调长 MCP initialize 超时：
# CODEAGENT_MCP_INITIALIZE_TIMEOUT_SECONDS=60

# ========== LLM HTTP 超时与重试（可选）==========
# SSE 流式接口下，readTimeout 是"两次 read 之间最大间隔"。
# GLM-5.1 在生成大段 reasoning_content 时服务端可能长时间静默，超时容易触发。
# 仅当遇到频繁 "调用 LLM 失败: timeout" 时再调大；通过 -D 系统属性传入：
#   java -Dcodeagent.llm.read.timeout.seconds=600 -jar target/codeagent-1.0-SNAPSHOT.jar
# 默认值：connect=60s / read=300s / write=60s / call=600s
# 408 / 429 / 500 / 502 / 503 / 504 与瞬时连接故障默认总尝试 3 次（即最多重试 2 次）。
# 可用系统属性调整；max-delay 同时限制指数退避与 Retry-After，避免异常长时间阻塞：
#   -Dcodeagent.llm.retry.max-attempts=3
#   -Dcodeagent.llm.retry.base-delay.millis=500
#   -Dcodeagent.llm.retry.max-delay.millis=30000
# Agent 默认不限制 ReAct / Plan 单任务 / SubAgent 的执行轮数。
# CI、Runtime API、微信无人值守或严格成本控制场景可显式设置正整数上限；
# 命中后会禁用工具并额外执行一次部分结果收尾：
#   java -Dcodeagent.react.hard.max.iterations=100 -jar target/codeagent-1.0-SNAPSHOT.jar

# 日志配置（支持自动滚动、压缩和清理）
# 默认日志目录：~/.codeagent/logs
# 默认日志文件：~/.codeagent/logs/codeagent.log
# 日志级别可选：ERROR / WARN / INFO / DEBUG
CODEAGENT_LOG_LEVEL=INFO

# 日志目录：默认使用 ~/.codeagent/logs，自动创建，无需填写
# 如需自定义，可取消下行注释
# CODEAGENT_LOG_DIR=~/.codeagent/logs

# 最多保留多少天的历史日志
CODEAGENT_LOG_MAX_HISTORY=7

# 单个日志文件滚动前的最大体积
CODEAGENT_LOG_MAX_FILE_SIZE=10MB

# 所有归档日志允许占用的总容量，超出后会自动清理更老的日志
CODEAGENT_LOG_TOTAL_SIZE_CAP=100MB

# ========== 操作审计配置 ==========
# 危险工具（write_file / execute_command / create_project / revert_turn）调用会按天写一行 JSONL 审计
# 默认目录：~/.codeagent/audit/audit-YYYY-MM-DD.jsonl
# 也可通过 -Dcodeagent.audit.dir=/path/to/dir 系统属性覆盖
# CODEAGENT_AUDIT_DIR=/Users/yourname/.codeagent/audit

# ========== 第 15 期：Skill 系统 ==========
# Skill 加载位置（按优先级，后者覆盖前者）：
#   1. jar 内置 (resources/skills/) — CodeAgent 自带 web-access
#   2. 用户级 ~/.codeagent/skills/<name>/SKILL.md
#   3. 项目级 <project>/.codeagent/skills/<name>/SKILL.md
# 启动期 jar 内置 skill 自动解压到 ~/.codeagent/skills-cache/<name>/，避免每次启动 IO
# 启用状态持久化：~/.codeagent/skills.json （格式 {"disabled": ["name1", ...]}，默认全启用）
# 内置 web-access 含决策手册 + 6 个 site-patterns（mp.weixin / zhihu / x.com / xiaohongshu / github / juejin）
# CLI: /skill list | /skill show <name> | /skill on/off <name> | /skill reload
# LLM 自决加载：当 system prompt 里某个 skill 的 description 匹配任务时，LLM 调 load_skill(name) 加载完整指引
