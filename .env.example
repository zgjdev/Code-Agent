# 选择一家 Provider；仅使用该家的密钥和模型，缺少密钥时报错，不自动换家。
# 支持 glm/deepseek/hunyuan/step/kimi/freellmapi/xfyun/agnes；其余密钥留空即可。
# KEY=value 不附行内注释；空目录/地址使用默认值。
CODEAGENT_PROVIDER=glm

# GLM：glm-5v-turbo 支持图片；其他可选 glm-5.0、glm-4-flash 等。
GLM_API_KEY=
GLM_MODEL=glm-5.1

# DeepSeek：可选 deepseek-v4-pro。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 腾讯混元
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy4-preview
HUNYUAN_BASE_URL=

# StepFun：专用通道可设置 https://api.stepfun.com/step_plan/v1。
STEP_API_KEY=
STEP_MODEL=step-3.5-flash
STEP_BASE_URL=

# Kimi：兼容 MOONSHOT_*；使用旧名时删除对应 KIMI_* 空赋值。
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=

# FreeLLMAPI：默认网关 http://localhost:5173/v1。
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_BASE_URL=

# 讯飞星辰 MaaS
XFYUN_MAAS_API_KEY=
XFYUN_MAAS_MODEL=Qwen3.6-35B-A3B
XFYUN_MAAS_BASE_URL=
XFYUN_MAAS_LORA_ID=

# Agnes AI
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=

# Web：AnySearch 密钥留空使用匿名访问；Step 降级复用 STEP_API_KEY。
ANYSEARCH_API_KEY=

# Session Memory：实验性增量摘要默认关闭；完整自动摘要仍启用。
CODEAGENT_SESSION_MEMORY_COMPACTION_ENABLED=false
CODEAGENT_SESSION_RESUME=auto

# LSP：默认开启，写入 Java 文件后检查语法。
CODEAGENT_LSP_ENABLED=true
CODEAGENT_LSP_MAX_DIAGNOSTICS=20

# Skill：内置 < ~/.codeagent/skills/ < 项目 .codeagent/skills/；目录含 SKILL.md。
# 默认启用；用 /skill list、/skill show <name>、/skill on|off <name>、/skill reload 管理。
# 禁用状态保存在 ~/.codeagent/skills.json，无 .env 开关。

# 代码检索：默认本地 Qwen3，先运行 scripts/install-qwen3-model.ps1 安装。
# 模型缺失仍可关键词检索；本地回滚设 EMBEDDING_PROVIDER=bge。
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL_DIR=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 远程模式可选 glm/jina/openai-compatible，仍需项目级授权。
# 自动索引通过 ~/.codeagent/config.json 的 autoIndex.enabled 管理，默认 true。

# 渲染器：inline/lanterna/plain；底部状态栏默认开启。
CODEAGENT_RENDERER=inline
CODEAGENT_NO_STATUSBAR=false

# Side-Git 快照：默认开启，路径留空使用 ~/.codeagent/snapshots。
CODEAGENT_SNAPSHOT_ENABLED=true
CODEAGENT_SNAPSHOT_MAX=50
CODEAGENT_SNAPSHOT_DIR=
CODEAGENT_SNAPSHOT_EXCLUDES=.git,.codeagent/snapshots,target,node_modules,dist,.idea,*.class,*.jar

# MCP：用户 ~/.codeagent/mcp.json，项目 .codeagent/mcp.json 优先。
# 配置引用 ${REMOTE_TOKEN} 时填写下方 token；浏览器登录态用 /browser connect。
REMOTE_TOKEN=
CODEAGENT_MCP_INITIALIZE_TIMEOUT_SECONDS=60

# 执行队列与 Runtime API：目录留空使用 ~/.codeagent/tasks 和 ~/.codeagent/runtime。
# Runtime API 启动命令见 README；必须填写独立 API Key，仅监听 127.0.0.1。
CODEAGENT_TASK_DIR=
CODEAGENT_RUNTIME_API_KEY=
CODEAGENT_RUNTIME_DIR=

# 日志：默认 ~/.codeagent/logs；审计：默认 ~/.codeagent/audit。
CODEAGENT_LOG_LEVEL=INFO
CODEAGENT_LOG_DIR=
CODEAGENT_LOG_MAX_HISTORY=7
CODEAGENT_LOG_MAX_FILE_SIZE=10MB
CODEAGENT_LOG_TOTAL_SIZE_CAP=100MB
CODEAGENT_AUDIT_DIR=

# LLM 超时、重试与轮数上限仍是 Java -D 参数，放在 -jar 前。
# -Dcodeagent.llm.read.timeout.seconds=600
# -Dcodeagent.llm.retry.max-attempts=3
# -Dcodeagent.llm.retry.base-delay.millis=500
# -Dcodeagent.llm.retry.max-delay.millis=30000
# -Dcodeagent.react.hard.max.iterations=100
